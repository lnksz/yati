#!/bin/sh
set -eu

appdir=$(dirname -- "$0")
if [ "${APPDIR:-}" != "$appdir" ]; then
    unset APPIMAGE
fi
APPDIR=$(realpath -- "$appdir")
export APPDIR
export XDG_DATA_DIRS="$APPDIR/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
export GDK_PIXBUF_MODULE_FILE="$APPDIR/usr/lib/yati-pixbuf-loaders.cache"
# Keep host GIO modules from loading against the bundled GLib.
export GIO_MODULE_DIR="$APPDIR/usr/lib/gio/modules"

if [ "$#" -eq 0 ]; then
    set -- gui
fi
exec "$APPDIR/usr/bin/yati" "$@"
